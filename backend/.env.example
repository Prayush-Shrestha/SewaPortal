SECRET_KEY=django-insecure-change-me-in-production-please
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (MySQL). Leave DB_HOST empty to use sqlite fallback for local dev ---
DB_NAME=community_portal
DB_USER=root
DB_PASSWORD=
DB_HOST=
DB_PORT=3306

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:3000

# --- JWT lifetimes (minutes / days) ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
